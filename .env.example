# =============================================================================
# AI Agent Assistant — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Domain Configuration
# -----------------------------------------------------------------------------

# Maximum number of characters allowed in a Task prompt.
# Increase for long-context models (e.g. Gemini 1.5 Pro supports ~1M tokens).
TASK_PROMPT_MAX_LENGTH=10000

# Local path for the SQLite database (introduced in Phase 2).
# Defaults to ~/.ai-agent-assistant/data.db if not set.
# DB_PATH=

# -----------------------------------------------------------------------------
# RAG Configuration (Phase 2)
# -----------------------------------------------------------------------------

# Local path for the ChromaDB vector store.
# Defaults to ~/.ai-agent-assistant/chroma if not set.
# CHROMA_PATH=

# Maximum number of document chunks returned per semantic search query.
# Increase for broader context, decrease for faster responses.
RAG_TOP_K=5

# -----------------------------------------------------------------------------
# LLM Provider API Keys
# (Add keys only for the providers you intend to use)
# -----------------------------------------------------------------------------

# Google AI Studio (Gemini) — Individual use. Free tier may use data for training.
# GEMINI_API_KEY=

# Vertex AI (Gemini Enterprise) — Corporate use. Guarantees data privacy.
# VERTEX_PROJECT_ID=
# VERTEX_LOCATION=europe-west1

# OpenAI
# OPENAI_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# API Server Configuration (Phase 4)
# -----------------------------------------------------------------------------

# Default LLM provider (gemini, openai, anthropic)
DEFAULT_PROVIDER=gemini

# Default model name
DEFAULT_MODEL=gemini-1.5-flash

# Maximum allowed file size for the Learning Agent in MB
MAX_LEARN_FILE_MB=50

# Path to declarative agents catalog (defaults to ./agents.yaml at project root)
# AGENTS_FILE=./agents.yaml

# Path to declarative debate topology (defaults to ./topology.yaml at project root)
# TOPOLOGY_FILE=./topology.yaml

# Internal review rounds between Reviewer and Proposers before HITL (0 to disable)
REVIEW_ROUNDS=1

# CORS Origins allowed by the API server
# CORS_ORIGINS=["http://localhost:5173", "http://localhost:4173"]

# -----------------------------------------------------------------------------
# Observability / Langfuse (Phase 6 / ADR 020)
# -----------------------------------------------------------------------------
# Active Docker Compose profiles when running 'docker compose up -d' without flags.
# Options:
#   (empty)       -> Launches core app (backend + frontend)
#   observability -> Launches core app + full local Langfuse stack (Postgres, Redis, Clickhouse, MinIO, Web, Worker)
#   scale         -> Launches core app + external Chroma, Postgres, Redis
#   full          -> Launches everything
COMPOSE_PROFILES=observability

# Set to 'true' to collect metrics/traces in Atenea backend.
LANGFUSE_METRICS_ENABLED=true
# Set these after initializing your local project at http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# -----------------------------------------------------------------------------
# Observability & Infrastructure Stack Credentials (Docker Compose)
# -----------------------------------------------------------------------------
# Default credentials for local container development.
# In production, staging, or multi-user deployments, ALWAYS override these values:
#
# PostgreSQL credentials (profiles: scale, observability, full)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=replace_with_secure_postgres_password
# POSTGRES_DB=postgres
#
# ClickHouse credentials (profiles: observability, full)
# CLICKHOUSE_USER=clickhouse
# CLICKHOUSE_PASSWORD=replace_with_secure_clickhouse_password
#
# MinIO S3 credentials (profiles: observability, full)
# MINIO_ROOT_USER=minio
# MINIO_ROOT_PASSWORD=replace_with_secure_minio_password
#
# Langfuse Web & Worker internal cryptographic secrets (profiles: observability, full)
# Generate random 32-byte strings (e.g. `openssl rand -hex 32`):
# NEXTAUTH_SECRET=replace_with_output_of_openssl_rand_hex_32
# SALT=replace_with_output_of_openssl_rand_hex_16
# ENCRYPTION_KEY=replace_with_output_of_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# Authentication & Security (Phase 7 / ADR 022)
# -----------------------------------------------------------------------------
# Secret key used to sign JWT session tokens (at least 32 characters required).
# If left commented out in local development, a random 48-byte key is generated per process.
# In production, ALWAYS set a persistent random secret (e.g. `openssl rand -base64 48`):
# AUTH_SECRET_KEY=replace_with_output_of_openssl_rand_base64_48
# Session token expiry in seconds (default: 28800 = 8 hours).
AUTH_TOKEN_EXPIRY_SECONDS=28800
# Set to 'true' in production HTTPS deployments.
AUTH_COOKIE_SECURE=false
# Cookie name for session transport.
AUTH_COOKIE_NAME=atenea_session
# SameSite attribute for the session cookie ('lax' or 'strict').
AUTH_COOKIE_SAMESITE=lax
# User Deletion Strategy ('soft' deactivates user preserving debate history, 'hard' permanently deletes from DB).
AUTH_DELETE_STRATEGY=soft
# Optional bootstrap token to protect /api/auth/setup in public/shared deployments.
# INITIAL_SETUP_TOKEN=your_secure_bootstrap_token_here
# Set to 'true' ONLY when running behind a trusted reverse proxy that overwrites X-Forwarded-For.
# AUTH_TRUST_X_FORWARDED_FOR=false
# Rate limiting configuration (requests per window)
# AUTH_RATE_LIMIT_LOGIN_ATTEMPTS=5
# AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
# AUTH_RATE_LIMIT_SETUP_ATTEMPTS=3
# AUTH_RATE_LIMIT_SETUP_WINDOW_SECONDS=60
# Optional PostgreSQL connection URL for enterprise deployments.
# DATABASE_URL=postgresql://user:password@localhost:5432/atenea

# -----------------------------------------------------------------------------
# Reverse Proxy & Network Isolation (Nginx Proxy Manager)
# -----------------------------------------------------------------------------
# Name of the Docker network shared with Nginx Proxy Manager.
# Default: npm-network
# NPM_NETWORK=npm-network

# Set to 'true' if NPM_NETWORK was already created manually in Docker (e.g. `docker network create npm-network`).
# Default: false (Compose creates it as a bridge if not present)
# NPM_NETWORK_EXTERNAL=false

# Host interface IP binding for local access (defaults to 127.0.0.1 so nothing is exposed to 0.0.0.0).
# FRONTEND_BIND_IP=127.0.0.1
# BACKEND_BIND_IP=127.0.0.1



